[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/world.gd" id="1_world"]
[ext_resource type="Script" path="res://scripts/map_loader.gd" id="2_loader"]
[ext_resource type="PackedScene" path="res://scenes/player.tscn" id="3_player"]
[ext_resource type="PackedScene" path="res://scenes/ui/dialogue_box.tscn" id="4_dialogue"]
[ext_resource type="Script" path="res://scripts/world_lighting.gd" id="5_lighting"]
[ext_resource type="Script" path="res://scripts/scene_planes.gd" id="6_planes"]
[ext_resource type="Script" path="res://scripts/world_fx.gd" id="7_fx"]

; The scene is containers only. Every plane's own children -- tiles, actors,
; scenery, effects, lights -- are built at runtime from map data, because a
; .tscn is a binary-ish blob nobody can review. See docs/architecture/scenery.md.
;
; World is NOT y-sorted: it holds planes, and sorting them against each other
; would merge the background into the world. Depth between planes is the
; PLANES order in scripts/scene_planes.gd; depth *inside* the playable plane
; is ground contact, as it always was.
[node name="World" type="Node2D"]
script = ExtResource("1_world")

[node name="Lighting" type="Node2D" parent="."]
script = ExtResource("5_lighting")

[node name="Planes" type="Node2D" parent="."]
script = ExtResource("6_planes")

; The gameplay plane. ScenePlanes gives it y_sort_enabled and z_index; these
; two nodes are the only things in the whole tree that are authored into it.
[node name="Playable" type="Node2D" parent="Planes"]
y_sort_enabled = true

[node name="MapLoader" type="Node2D" parent="Planes/Playable"]
y_sort_enabled = true
script = ExtResource("2_loader")

[node name="Player" parent="Planes/Playable" instance=ExtResource("3_player")]

[node name="Fx" type="Node2D" parent="."]
script = ExtResource("7_fx")

[node name="DialogueBox" parent="." instance=ExtResource("4_dialogue")]

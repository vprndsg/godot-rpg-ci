# Godot 4
.godot/
/android/
export_presets.local.cfg

# Build output (published by the deploy workflow, never committed)
build/
/dist/

# Editor / OS noise
*.tmp
.DS_Store
Thumbs.db

# Local Godot binaries pulled by scripts/dev_setup.sh
/.tools/

# Python bytecode from tools/
__pycache__/
*.pyc

# Reference boards from tools/gen_art_ai.py. These are inspiration for a human
# or an agent to look at, never shipped art -- everything under assets/ must
# stay reproducible from code.
docs/art/refs/

# The inbox is a staging area: Godot must not import what lands in it,
# and the pipeline consumes the source into assets/packs/ as it installs it.
inbox/*.import
